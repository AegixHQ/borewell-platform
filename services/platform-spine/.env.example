# Local development settings for platform-spine (copy to .env).
# Production uses the root .env.prod instead - see docs/deployment/GO-LIVE.md.

# Postgres connection. Example: postgresql://borewell:borewell@localhost:5432/platform_spine
DATABASE_URL=postgresql://borewell:borewell@localhost:5432/platform_spine

# Signs login tokens; every service must use the same value. Any string works
# locally; in production use a long random one (`openssl rand -base64 48`).
# Example: JWT_SECRET=Yk2n8Qe5uT1vW7xZb3Cd9Fg4Hj6Lm0PrSt8Vw2Xy4Za6Bc1De3Fg5Hj7
JWT_SECRET=change-me-in-any-real-deployment
JWT_EXPIRY_MINUTES=60

# Google sign-in (optional). Empty = off: POST /v1/auth/google answers 503.
# WHAT:  Client ID(s) of a *Web application* OAuth client, comma-separated.
#        A public identifier, not a secret.
# WHERE: console.cloud.google.com -> APIs & Services -> Credentials ->
#        Create credentials -> OAuth client ID -> Web application.
#        The mobile app's EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID must be the same.
# Example: GOOGLE_CLIENT_IDS=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=
