DATABASE_URL=postgresql://borewell:borewell@localhost:5432/payments_data
JWT_SECRET=change-me-in-any-real-deployment
QUOTATION_SERVICE_URL=http://localhost:8002
# Razorpay - see app/gateway/razorpay_client.py for the integration and
# its HONEST CAVEAT (built without live access to current Razorpay docs -
# verify against https://razorpay.com/docs/ before using in production).
# All 3 required for POST /v1/payments/{id}/create-order and
# POST /v1/payments/webhook to work - both fail closed (502/400) if unset,
# not silently no-op. Get these from the Razorpay Dashboard:
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Settings -> API Keys
#   RAZORPAY_WEBHOOK_SECRET: Settings -> Webhooks (set when you configure
#     the webhook URL there, NOT derived from the API keys above)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
