DATABASE_URL=postgresql://borewell:borewell@localhost:5432/payments_data
JWT_SECRET=change-me-in-any-real-deployment
QUOTATION_SERVICE_URL=http://localhost:8002
# Razorpay (optional locally). Leave all three blank and online payment is off
# (create-order answers 502); cash payments still work. Production setup is in
# the root .env.prod.example and docs/deployment/GO-LIVE.md. Fill all three or
# none. The integration is in app/gateway/razorpay_client.py - check it against
# https://razorpay.com/docs/ before touching real money.
#
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET
#   WHERE: Razorpay Dashboard -> Settings -> API Keys -> Generate Key. Use TEST
#          MODE locally: rzp_test_... keys never move real money.
#   Example: RAZORPAY_KEY_ID=rzp_test_AbCdEf1234GhIj
#   Example: RAZORPAY_KEY_SECRET=aBcDeF0123456789gHiJkLmN
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET
#   WHERE: Dashboard -> Settings -> Webhooks -> Add New Webhook; the secret is a
#          random string you choose there (8+ chars). Not derived from the keys.
#          Razorpay cannot reach a laptop, so locally the app completes payments
#          through POST /v1/payments/{id}/verify and the webhook is only needed
#          on a public server.
#   Example: RAZORPAY_WEBHOOK_SECRET=whsec_Xk39dLq82mPz
RAZORPAY_WEBHOOK_SECRET=
