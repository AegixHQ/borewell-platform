# Copy to .env (gitignored, same convention as every other .env in this
# repo - see root .gitignore's "# Env" section) and fill in your
# machine's real LAN IP - NOT localhost. See services/platform.js's
# comment for why localhost doesn't work from a simulator/emulator/device.
EXPO_PUBLIC_PLATFORM_SPINE_URL=http://192.168.1.X:8001
EXPO_PUBLIC_QUOTATION_URL=http://192.168.1.X:8002
EXPO_PUBLIC_RESOURCE_NETWORK_URL=http://192.168.1.X:8003
EXPO_PUBLIC_PAYMENTS_URL=http://192.168.1.X:8004

# Google sign-in (optional; Android/iOS builds only, not Expo Go or web).
# The *Web application* OAuth client ID. The server's GOOGLE_CLIENT_IDS must
# contain the same value. Needs an Android OAuth client too (package
# in.aegix.borewell + the signing key's SHA-1) in the same Google Cloud
# project. Leave empty and the Google button is hidden.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Map tiles (optional). Overrides the built-in OpenStreetMap -> CARTO chain,
# e.g. your own MapTiler/Stadia URL: https://.../{z}/{x}/{y}.png
# EXPO_PUBLIC_TILE_URL=
# EXPO_PUBLIC_TILE_CREDIT=
