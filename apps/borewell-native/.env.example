# Copy to .env (gitignored, same convention as every other .env in this
# repo - see root .gitignore's "# Env" section) and fill in your
# machine's real LAN IP - NOT localhost. See services/platform.js's
# comment for why localhost doesn't work from a simulator/emulator/device.
EXPO_PUBLIC_PLATFORM_SPINE_URL=http://192.168.1.X:8001
EXPO_PUBLIC_QUOTATION_URL=http://192.168.1.X:8002
EXPO_PUBLIC_RESOURCE_NETWORK_URL=http://192.168.1.X:8003
EXPO_PUBLIC_PAYMENTS_URL=http://192.168.1.X:8004
