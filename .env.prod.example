# Borewell production settings - the ONE file you fill in to go live.
#
#   make prod-init DOMAIN=api.yourdomain.in EMAIL=you@yourdomain.in
#       creates .env.prod from this file and generates the three internal
#       secrets for you (never overwrites an existing .env.prod)
#   # open .env.prod and fill in the section marked  >>> YOU ENTER <<<
#   make prod-check       # validates everything and tells you what is wrong
#   make prod-deploy      # preflight -> build -> start (HTTPS) -> smoke test
#
# .env.prod is gitignored. This example file holds no real secrets.
#
# Three kinds of value below:
#   AUTO     make prod-init generates these. Leave them alone.
#   ENTER    only you can supply these (domain, Razorpay, Google, admin).
#   DEFAULT  already set to the safe go-live value. Change only on purpose.
#
# Every "Example:" line shows the FORMAT of a real value so you can recognise
# it when you see it. They are made up - `make prod-check` rejects them if you
# paste one in unchanged. No quotes, no spaces around "=".

# =============================================================================
# AUTO - generated by `make prod-init` (do not edit; changing JWT_SECRET logs
# everyone out, changing POSTGRES_PASSWORD after first start needs a manual
# ALTER USER in each database)
# =============================================================================
# Shared by the four databases. Example: POSTGRES_PASSWORD=q3Zt8mVw1LxR7cNp2HkYb5Ds
POSTGRES_PASSWORD=CHANGE_ME
# Signs every login token; all four services verify with the same value.
# Example: JWT_SECRET=Yk2n8Qe5uT1vW7xZb3Cd9Fg4Hj6Lm0PrSt8Vw2Xy4Za6Bc1De3Fg5Hj7
JWT_SECRET=CHANGE_ME
# Grafana's own admin login (http://localhost:3000 on the server, or over an SSH
# tunnel - it is not exposed to the internet).
# Example: GRAFANA_ADMIN_PASSWORD=Pw4x9Kd2Lm7Qr1Tz6V
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# =============================================================================
# >>> YOU ENTER <<<
# =============================================================================

# ---- Your domain and HTTPS ---------------------------------------------------
# WHAT:  the hostname the apps will call. Bare hostname: no https://, no slash,
#        no port, not an IP address.
# WHERE: you choose it; buy/own the domain, then add a DNS "A record" for it
#        pointing at this server's public IP (at your domain registrar or
#        Cloudflare). Open ports 80 and 443 on the server's firewall.
# Example: PUBLIC_DOMAIN=api.yourdomain.in
PUBLIC_DOMAIN=
# WHAT:  where Let's Encrypt sends certificate-expiry warnings.
# Example: LETSENCRYPT_EMAIL=you@yourdomain.in
LETSENCRYPT_EMAIL=
# For a first dry run (avoids Let's Encrypt rate limits; phones will warn about
# the certificate) uncomment this; remove it again for the real run:
# LETSENCRYPT_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# ---- Razorpay (online payments) ----------------------------------------------
# Leave ALL THREE blank to run CASH-ONLY (the app then tells customers online
# payment is off). Fill all three or none.
#
# RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET
#   WHERE: Razorpay Dashboard -> Settings -> API Keys -> Generate Key.
#          The Dashboard has a Test Mode / Live Mode switch (top of the page):
#          rzp_test_... = test mode, no real money; rzp_live_... = real money.
#          START WITH TEST KEYS, switch to live after a test payment works.
#          The secret is shown once - copy it immediately.
#   Example: RAZORPAY_KEY_ID=rzp_test_AbCdEf1234GhIj
#   Example: RAZORPAY_KEY_SECRET=aBcDeF0123456789gHiJkLmN
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET
#   WHERE: Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
#            Webhook URL:  https://<PUBLIC_DOMAIN>/v1/payments/webhook
#                          (`make prod-check` prints the exact URL)
#            Active events: payment.captured and payment.failed
#            Secret:        a random string YOU make up there (8+ characters);
#                           paste the very same string here.
#          It is NOT derived from the API keys. Test mode and live mode have
#          separate webhooks - create one in each mode you use.
#   Example: RAZORPAY_WEBHOOK_SECRET=whsec_Xk39dLq82mPz
RAZORPAY_WEBHOOK_SECRET=

# ---- Google sign-in ----------------------------------------------------------
# Pre-filled with the project's Web client ID (a public identifier, safe to
# commit). Blank it to keep "Continue with Google" off.
# WHAT:  the Client ID of a *Web application* OAuth client. It is a public
#        identifier, not a secret. Comma-separate several.
# WHERE: console.cloud.google.com -> pick/create a project -> APIs & Services
#        -> OAuth consent screen (set it up once) -> Credentials -> Create
#        credentials -> OAuth client ID -> Application type "Web application"
#        -> copy the Client ID.
#        Then, in the SAME project, create a second client of type "Android"
#        with package name in.aegix.borewell and the SHA-1 printed in the APK
#        release notes. (The Android client's ID is not used anywhere - Google
#        just needs it to exist.)
#        The mobile app build needs the same Web client ID: GitHub variable
#        GOOGLE_WEB_CLIENT_ID (docs/deployment/GO-LIVE.md step 7).
# Example: GOOGLE_CLIENT_IDS=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=603105294808-8cqk32vc3c1kkpk25u72bi9gq17hs8ir.apps.googleusercontent.com

# ---- First admin (one time) --------------------------------------------------
# WHAT:  your own admin login. Public sign-up cannot create an admin, so this
#        is the only way to get the first one.
# HOW:   set BOTH, deploy once, then DELETE the password line and deploy again.
#        Create-only: an existing account is never changed. Use a real email
#        address (".local" addresses are rejected at login); password 12+
#        characters.
# Example: BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.in
# Example: BOOTSTRAP_ADMIN_PASSWORD=Use-A-Long-Passphrase-1
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# =============================================================================
# DEFAULT - safe go-live values
# =============================================================================
# Browser origins allowed to call the API (CORS). Blank = https://<PUBLIC_DOMAIN>,
# which is right unless a web front end is served from a different domain; then
# list its https origin(s), comma-separated. The mobile app is not affected by CORS.
# Example: ALLOWED_ORIGINS=https://app.yourdomain.in,https://admin.yourdomain.in
ALLOWED_ORIGINS=

# Only the gateway (ports 80/443) is public; the four service ports listen on
# this machine only, and per-client rate limits read the real client IP that the
# gateway forwards. These two go together - `make prod-check` refuses
# TRUST_FORWARDED_FOR=1 with SERVICE_BIND_ADDR=0.0.0.0.
SERVICE_BIND_ADDR=127.0.0.1
RATE_LIMIT_TRUST_FORWARDED_FOR=1

# 0 = a contractor account can only be created by hand (a contractor can read
# every customer's jobs and payments). Create one with:
#   make prod-contractor EMAIL=owner@yourdomain.in
ALLOW_PUBLIC_CONTRACTOR_REGISTRATION=0

# Grafana is reachable from this machine only. To view it from your laptop:
#   ssh -L 3000:localhost:3000 user@<server>   then open http://localhost:3000
GRAFANA_BIND_ADDR=127.0.0.1
