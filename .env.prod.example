# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   # fill in every value below, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod is gitignored (see .gitignore's "# Env" section) - never commit
# real secrets. This file (.env.prod.example) has no real values, only
# placeholders and generation instructions, so it's safe to commit.

# ---- Database ----
# Shared across all 4 Postgres containers (DB-per-service, but one
# password for the pilot's single VM - Architecture doc section 9 asks
# for "a real secrets manager once there's a staging/prod target", which
# this single-VM pilot doesn't have yet; a per-DB password would be the
# next hardening step once that exists, not before).
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# ---- Auth ----
# All 4 backend services verify JWTs locally using this SAME secret
# (Architecture doc section 6: platform-spine issues, every other service
# verifies locally, no per-request callback) - it must be identical across
# platform-spine/quotation/resource-network/payments-data, which is why
# it's one value here rather than 4 separate ones.
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# ---- Networking ----
# The PUBLIC URL this VM is reachable at - a real domain with HTTPS
# (e.g. https://app.yourdomain.in) once DNS/TLS exist, or the VM's public
# IP as an interim step (e.g. http://203.0.113.10). This gets used two
# ways:
#   1. Baked into the frontend's build (VITE_*_URL build args in
#      docker-compose.prod.yml) so the browser knows where to call each
#      backend service.
#   2. Should also be reflected in ALLOWED_ORIGINS below, so the backend
#      accepts CORS requests FROM this same origin.
# No trailing slash, no port - each service's port is appended in
# docker-compose.prod.yml's build args.
PUBLIC_URL=http://CHANGE_ME

# CORS allow-list - a comma-separated list of origins the browser is
# allowed to call these APIs from. Must include the actual origin
# web-app is served from in production (port 80, so just PUBLIC_URL with
# no port suffix - e.g. "http://203.0.113.10" or "https://app.yourdomain.in").
# Dev's default list (localhost:5173/5174/5175) has no reason to be in
# this list for a real deployment - real users are never on localhost.
ALLOWED_ORIGINS=http://CHANGE_ME

# ---- Payments (Razorpay) ----
# See services/payments-data/app/gateway/razorpay_client.py for the
# integration logic and its HONEST CAVEAT: built without live access to
# current Razorpay docs, based on their long-stable Orders API and
# webhook signature scheme - verify against https://razorpay.com/docs/
# before this ever touches a real payment.
#
# All 3 required for POST /v1/payments/{id}/create-order and
# POST /v1/payments/webhook to work - both fail closed (502/400) if any
# are unset, never silently no-op or fake success.
#
# Get these from the Razorpay Dashboard:
RAZORPAY_KEY_ID=CHANGE_ME
#   Settings -> API Keys. Starts with "rzp_live_" in production, "rzp_test_"
#   in Razorpay's test mode - double check you're using the live key here,
#   not a test key left over from local development.
RAZORPAY_KEY_SECRET=CHANGE_ME
#   Same page as RAZORPAY_KEY_ID above. Private - never log this, never
#   expose it to the frontend (only KEY_ID is safe to expose - see
#   CreateOrderResponse.razorpay_key_id in payments-data's schemas.py).
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
#   Settings -> Webhooks. This is generated when you configure the
#   webhook URL in the Razorpay dashboard (point it at
#   https://<PUBLIC_URL>:8004/v1/payments/webhook, or through a reverse
#   proxy once one exists - see docs/deployment/PRODUCTION.md step 7) -
#   it is NOT derived from or related to the two keys above. Losing this
#   value means regenerating it in the dashboard and updating it here;
#   it cannot be recovered from Razorpay's side once dismissed from their
#   UI, same as any other secret they generate once and show you once.
